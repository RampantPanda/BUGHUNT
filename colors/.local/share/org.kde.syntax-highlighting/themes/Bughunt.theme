{
    "_comments": [
        "BUGHUNT color theme generated from the user's BUGHUNT master palette.",
        "Low-saturation amber/brown UI with restrained syntax colors."
    ],
    "metadata": {
        "name": "BUGHUNT",
        "revision": 1,
        "license": "SPDX-License-Identifier: MIT"
    },
    "editor-colors": {
        "BackgroundColor": "#1d170b",
        "TextSelection": "#3b3000",
        "CurrentLine": "#251f0d",
        "SearchHighlight": "#756000",
        "ReplaceHighlight": "#752300",
        "IconBorder": "#1d170b",
        "LineNumbers": "#665d45",
        "CurrentLineNumber": "#9c8000",
        "Separator": "#3b3000",
        "WordWrapMarker": "#3b3000",
        "CodeFolding": "#3b3000",
        "ModifiedLines": "#78a9b7",
        "SavedLines": "#9dbb72",
        "SpellChecking": "#d05a43",
        "TabMarker": "#3b3000",
        "IndentationLine": "#3b3000",
        "BracketMatching": "#756000",
        "MarkBookmark": "#7dbdb2",
        "MarkBreakpointActive": "#d05a43",
        "MarkBreakpointReached": "#c5a629",
        "MarkBreakpointDisabled": "#665d45",
        "MarkExecution": "#9dbb72",
        "MarkWarning": "#c5a629",
        "MarkError": "#d05a43",
        "TemplateBackground": "#2a230f",
        "TemplatePlaceholder": "#3b3000",
        "TemplateFocusedPlaceholder": "#756000",
        "TemplateReadOnlyPlaceholder": "#1d170b"
    },
    "text-styles": {
        "Normal": {
            "text-color": "#c7bd94",
            "selected-text-color": "#e1d8b4"
        },
