[General]
ColorScheme=Muthur
Name=MUTHUR
shadeSortColumn=true

# Keep Qt derived shade roles dark with contrast=0.
# Higher values make QPalette::Light/Midlight absurdly bright on this dark palette.
# Nextcloud uses QPalette::Light for large settings-panel backgrounds.
[KDE]
contrast=0

