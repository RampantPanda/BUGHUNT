{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	  "type": "file",
	  "source": "~/.config/fastfetch/w.ansi",
	},
    "display": {
        "separator": " > ",
        "color": {
            "keys": "green",
            "separator": "bold_green",
            "output" : "yellow"
        },
        "size": {
            "ndigits": 0,
            "maxPrefix": "MB"
        },
        "key": {
            "type": "string"
        }
    },
    "modules": [
		"break",
        {
            "type": "title",
            "color": {
                "user": "green",
                "at": "blue",
                "host": "yellow"
            }
        },
        {
        	"type": "WM",
        	"format": "{pretty-name}"
        },
        {
        	"type": "os",
        	"format": "{pretty-name}"
        },

        "break",
                {
        	"type": "Chassis",
        	"format": "{vendor}"
        },

        "break",
        "uptime",
        {
        "type" : "disk",
        "format" : "{size-available} free"
        },
        "break",
        {
        "type":"Wifi",
        "format":"{ssid}-{security}"
        },
        {"type":"PublicIp",
        "format":"{ip}|{location}"
        }
        ]
}
