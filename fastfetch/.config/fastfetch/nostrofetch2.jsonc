{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	  "type": "file",
	  "source": "~/.config/fastfetch/w.ansi",
	},
    "display": {
        "separator": "  ",
        "color": {
            "keys": "magenta"
        },
        "size": {
            "ndigits": 0,
            "maxPrefix": "MB"
        },
        "key": {
            "type": "string"
        }
    },
    "modules": [
		"break",
        {
            "type": "title",
            "color": {
                "user": "green",
                "at": "red",
                "host": "blue"
            }
        },
        {
        	"type": "WM",
        	"format": "{pretty-name}"
        },
        {
        	"type": "os",
        	"format": "{pretty-name}"
        },
        "kernel",
        "break",
        "Host",
        {
        	"type": "Chassis",
        	"format": "{vendor}"
        },

        "break",
        "uptime",
        "display",
        {
        "type" : "disk",
        "format" : "{size-used}/{size-total} used"
        },
        "break",
        "Wifi",
        "PublicIp"
        ]
}
