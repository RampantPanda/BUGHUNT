;; THIS IS THE WINDOW
(defwindow sysmon
  :monitor 0
  :geometry (geometry
    :anchor "top right"
    :x "30px"
    :y "30px"
    :width "300px"
    :height "430px")
  :stacking "bg"
  :exclusive false
  :focusable false
  (system-widget))
  
;; THIS IS THE ONLY WIDGET IN THE WINDOW
;; THERE CAN ONLY BE ONE
(defwidget system-widget []
  (box
    :class "system-widget"
    :orientation "vertical"
    :spacing 6

	(host-widget)
    (disk-widget)
    (ram-widget)
    (proton-widget)
    ))  

;; THESE ARE THE POLLS THAT PULL THE DATA
(defpoll disk_usage
  :interval "60s"
  "$HOME/.config/eww/scripts/du.sh")

(defpoll proton_status
  :interval "5s"
  "$HOME/.config/eww/scripts/proton-status.sh")

(defpoll ram_usage
	:interval "5s"
	"$HOME/.config/eww/scripts/ram-use.sh")
	
(defpoll hostname
  :interval "6000s"
  "$HOME/.config/eww/scripts/host-name.sh")
	
;; THESE ARE THE WIDGETS INSIDE THE SYSTEM WIDGET
(defwidget disk-widget []
  (box
    :class "disk-widget"
    :orientation "horizontal"
    (label :text disk_usage)))

(defwidget proton-widget []
  (box
    :class "proton-widget"
    :orientation "horizontal"
    (label :text proton_status)))

(defwidget ram-widget []
	(box
		:class "ram-widget"
		:orientation "horizontal"
		(label :text ram_usage)))

(defwidget host-widget []
	(box
		:class "host-widget"
		:orientation "horizontal"
		(label :text hostname)))




