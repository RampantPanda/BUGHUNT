;; THIS IS THE SYSMON WINDOW
(defwindow sysmon
  :monitor 0
  :geometry (geometry
    :anchor "top right"
    :x "30px"
    :y "30px"
    :width "300px"
    :height "430px")
  :stacking "bg"
  :exclusive false
  :focusable false
  (system-widget))
  
;; THIS IS THE ONLY WIDGET IN THE SYSMON WINDOW
;; THERE CAN ONLY BE ONE
(defwidget system-widget []
  (box
    :class "system-widget"
    :orientation "vertical"
    :spacing 6

	(host-widget)
	(uptime-widget)
	(battery-widget)
	(proton-widget)
    (cpu-widget)	
    (disk-widget)
    (ram-widget)
    (pacnew-widget)
    (swap-widget)
    (failed-units-title)
    (failed-units-widget)
    ))  

;; THESE ARE THE POLLS THAT PULL THE DATA
(defpoll disk_usage
  :interval "60s"
  "$HOME/.config/eww/scripts/du.sh")

(defpoll proton_status
  :interval "5s"
  "$HOME/.config/eww/scripts/proton-status.sh")

(defpoll hostname
  :interval "6000s"
  "$HOME/.config/eww/scripts/host-name.sh")

(defpoll cpu_usage
  :interval "2s"
  `~/.config/eww/scripts/cpu.sh`)
  
  (defpoll ram_usage
  :interval "2s"
  `~/.config/eww/scripts/ram.sh`)
  
(defpoll failed_system_units
  :interval "10s"
  `systemctl --failed --no-legend --plain --no-pager | awk 'NF {n++} END {print n+0}'`)

(defpoll failed_user_units
  :interval "10s"
  `systemctl --user --failed --no-legend --plain --no-pager | awk 'NF {n++} END {print n+0}'`)
  
  (defpoll root_disk
  :interval "30s"
  `~/.config/eww/scripts/disk.sh / ROOT`)

(defpoll home_disk
  :interval "30s"
  `~/.config/eww/scripts/disk.sh /home HOME`)
  
  (defpoll network
  :interval "10s"
  `~/.config/eww/scripts/network.sh`)
  
  (defpoll uptime
  :interval "15m"
  `uptime -p | sed 's/^up //'`)
  
  (defpoll load_1m
  :interval "5s"
  `awk '{print $1}' /proc/loadavg`)
  
  (defpoll battery
  :interval "30s"
  `~/.config/eww/scripts/battery.sh`)
  
  (defpoll updates
  :interval "60m"
  `checkupdates 2>/dev/null | wc -l`)
  
  (defpoll pacnew
  :interval "60m"
  `pacdiff --output 2>/dev/null | wc -l`)
			
;; THESE ARE THE WIDGETS INSIDE THE SYSTEM WIDGET
(defwidget disk-widget []
  (box
    :class "disk-widget"
    :orientation "horizontal"
    :halign "start"
    (label :text disk_usage)))

(defwidget proton-widget []
  (box
    :class "proton-widget"
    :orientation "horizontal"
    :halign "start"
    (label :text proton_status)))


(defwidget host-widget []
	(box
		:class "host-widget"
		:orientation "horizontal"
		:halign "start"
		(label :text hostname)))

(defwidget ram-widget []
	(box
		:class "ram-widget"
		:orientation "horizontal"
		:halign "start"
		(label :text "RAM ${ram_usage}")))

(defwidget cpu-widget []
	(box
		:class "cpu-widget"
		:orientation "horizontal"
		:halign "start"
		(label :text "${cpu_usage}%")))

(defwidget failed-units-title []
			(revealer
			:reveal {failed_system_units > 0}
			:class "failed-units-title"
			:orientation "horizontal"
			:halign "center"
			(label :text "SYSTEM FAIL COUNT")))
			
(defwidget failed-units-widget []
  (box
    :orientation "h"
    :spacing 6

    (revealer
      :reveal {failed_system_units > 0}
      :transition "slideleft"
      :duration "200ms"
      (label
        :class "failed-units failed-system"
        :tooltip "systemctl --failed"
        :text "SYS ${failed_system_units}"))

    (revealer
      :reveal {failed_user_units > 0}
      :transition "slideleft"
      :duration "200ms"
      (label
        :class "failed-units failed-user"
        :tooltip "systemctl --user --failed"
        :text "USR ${failed_user_units}"))))

(defwidget uptime-widget []
	(box
		:orientation "h"
		:spacing 2
		(label :text "TIME SINCE LAUNCH ${uptime}")))
(defwidget battery-widget []
	(revealer
		:reveal {battery != ""}
		(label :text battery)))
		
(defwidget pacnew-widget []
	(revealer
	:reveal {pacnew > 0}
	  (label
		:class "warning"
		:text "PACNEW ${pacnew}")))
		
(defwidget swap-widget []		
	(revealer
		:reveal {swap != ""}
		(label
			:class "warning"
			:text swap)))
